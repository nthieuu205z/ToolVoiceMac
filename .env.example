# Copy to ~/Library/Application Support/ToolVoiceMac/.env if configuring manually.
# Keep real API keys in the private .env, never in this tracked example.
GEMINI_API_KEY=
GEMINI_BACKEND=developer
STT_PROVIDER=whisper
TTS_PROVIDER=edge
CLONE_TTS_PROVIDER=omnivoice
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
WHISPER_MODEL=small
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_BATCH_SIZE=8
OMNIVOICE_NUM_STEP=32
OMNIVOICE_BATCH_SIZE=0
OMNIVOICE_OPTIMIZATION=split-cfg-rms-gqa-rope
OMNIVOICE_CODEC_DEVICE=mps
STT_WORKERS=1
TTS_WORKERS=2
TRANSLATE_WORKERS=6
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_MB=8192
# Optional custom binary locations:
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe
