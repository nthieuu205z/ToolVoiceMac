# Sao chép file này thành `.env` rồi điền khóa API thật.
#     cp .env.example .env
#
# KHÔNG điền khóa vào chính file này. File .env.example được commit và chia sẻ;
# chỉ .env mới nằm trong .gitignore.
#
# Lấy khóa tại: https://aistudio.google.com/apikey

GEMINI_API_KEY=your-api-key-here

# Khóa API đi tới endpoint nào. Cùng một khóa, hai endpoint — chọn nhầm là 403 hoặc 401.
#
#   developer  generativelanguage.googleapis.com
#              Dùng cho khóa lấy từ https://aistudio.google.com/apikey
#
#   vertex     aiplatform.googleapis.com (Vertex AI Express Mode)
#              Dùng cho khóa tạo trong project Google Cloud. Nếu Developer API trả
#              403 API_KEY_SERVICE_BLOCKED thì đây là thứ bạn cần.
#              Lưu ý: Vertex không có models.list(), và không phải model nào cũng có
#              (đã kiểm chứng có: gemini-3.5-flash, gemini-2.5-flash, gemini-2.5-pro).
GEMINI_BACKEND=developer

# ─── Nhà cung cấp cho từng bước ────────────────────
# Mặc định né hẳn trần 100 lượt/ngày của Gemini TTS.
#
#   STT_PROVIDER=whisper  Whisper chạy trên máy — miễn phí, không hạn mức, không cần mạng.
#                         Chậm: chép lời tuần tự trên CPU (đặt STT_WORKERS=1).
#   STT_PROVIDER=gemini   Gemini audio understanding — nhanh và chuẩn hơn Whisper small,
#                         chịu được STT_WORKERS=8 luồng song song. Khuyến nghị khi bạn
#                         chấp nhận trả phí API (bản miễn phí thì tốn hạn mức ngày).
#
#   TTS_PROVIDER=edge     edge-tts — miễn phí, không cần API key, KHÔNG cần tải model,
#                         nhưng cần kết nối mạng khi tạo audio.
#                         14 giọng: 2 giọng Việt bản địa + 12 giọng "Multilingual" đọc
#                         được tiếng Việt (đã kiểm chứng bằng cách nghe lại). Nhanh nhất.
#                         Nhược: endpoint không chính thức của trình duyệt Edge, Microsoft
#                         không cam kết gì; nó bóp tần suất nên TTS_WORKERS=2 + retry.
#

#   CLONE_TTS_PROVIDER=omnivoice  OmniVoice — TTS nhân bản zero-shot đa ngôn ngữ, chạy trên GPU
#                         khi accelerator probe và smoke test xác nhận an toàn.
#                         CHỈ đọc bằng giọng NHÂN BẢN: không có giọng dựng sẵn — mỗi giọng lấy
#                         từ clip mẫu bạn đã tải, Whisper chép lời một lần.
#                         Cài bằng extra: uv pip install -e ".[omnivoice]".
#                         Trọng số CC-BY-NC (PHI THƯƠNG MẠI).
#
#   TTS_PROVIDER=gemini   30 giọng, nhưng trần ~100 lượt/ngày ở bản miễn phí → video dài
#                         sẽ câm giữa chừng. Không khuyến khích.
#
# Bước DỊCH luôn dùng Gemini, và chỉ tốn 1–4 lượt gọi cho cả video.
STT_PROVIDER=whisper
TTS_PROVIDER=edge

# Engine riêng cho giọng nhân bản; không ảnh hưởng giọng dựng sẵn của TTS_PROVIDER.
# OmniVoice không tự lùi sang engine khác; none = tắt nhân bản.
CLONE_TTS_PROVIDER=omnivoice



# ─── Model Gemini ──────────────────────────────────
# Chạy `python scripts/check_setup.py` để xem model nào đang khả dụng với khóa của bạn.
GEMINI_TRANSLATE_MODEL=gemini-3.5-flash
# Chỉ dùng khi đặt STT_PROVIDER/TTS_PROVIDER về gemini:
GEMINI_STT_MODEL=gemini-3.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# ─── Whisper chạy trên máy ─────────────────────────
# tiny | base | small | medium | large-v3 — càng lớn càng chuẩn, càng chậm.
# Lần chạy đầu sẽ tải model về (~460 MB với bản 'small').
WHISPER_MODEL=small
# faster-whisper trên Apple Silicon chạy batch CPU; 0 = từng vùng, 8 = mức khuyến nghị cho M1 Max 64 GB.
WHISPER_CPU_BATCH_SIZE=8

# ─── edge-tts ──────────────────────────────────────
# Dịch vụ thỉnh thoảng từ chối rồi tự hồi sau vài phút — thử lại là bắt buộc.
EDGE_TTS_ATTEMPTS=5

# ─── ffmpeg ────────────────────────────────────────
# Để trống thì tìm trong PATH (sau khi `brew install ffmpeg`).
# FFMPEG_BIN=/opt/homebrew/bin/ffmpeg
# FFPROBE_BIN=/opt/homebrew/bin/ffprobe

# ─── Tinh chỉnh pipeline ───────────────────────────
# Thời lượng tối đa một vùng phát ngôn trước khi tách câu theo mốc Whisper.
# 12 là cân bằng tốt; tăng lên chỉ để giảm số lượt gọi cho đường không có timing câu.
MAX_UTTERANCE_SECONDS=12
# Khoảng lặng ngắn hơn ngưỡng này được coi là nghỉ lấy hơi, hai vế nối làm một lượt.
MAX_UTTERANCE_GAP=0.5

# Số luồng chép lời song song. Gemini: 8. Whisper: 1 (tự tuần tự hóa bên trong,
# tăng lên chỉ khiến các luồng tranh CPU).
STT_WORKERS=1
# Đo thực nghiệm với edge-tts: 6 luồng → 25/32 hỏng; 2 luồng → 10/10.
TTS_WORKERS=2

# Giới hạn tăng tốc khi giọng đọc dài hơn khung thời gian gốc.
TTS_MAX_SPEEDUP=1.3
# Sàn kéo chậm câu ngắn để bám hình; 1.0 = tắt.
TTS_FILL_SLOWDOWN=0.9
# Whisper có mốc từng từ để tách câu; đặt false để đọc theo vùng.
SENTENCE_LEVEL_TIMING=true
# Số lô dịch chạy song song; hạ nếu API Gemini free tier bị 429.
TRANSLATE_WORKERS=6
# Chỉ có ý nghĩa khi TTS_PROVIDER=gemini: cảnh báo trước nếu video cần quá nhiều lượt gọi.
TTS_DAILY_BUDGET=90

MAX_UPLOAD_MB=8192

# Số video xử lý ĐỒNG THỜI. Video nộp thêm sẽ xếp hàng chờ, không bị từ chối.
# Để 2 là hợp lý: Whisper/OmniVoice bị khóa suy luận toàn cục và edge-tts bị trần
# 2 request đồng thời, nên tăng số này chủ yếu chỉ khiến các job chen nhau.
MAX_CONCURRENT_JOBS=2

# ─── Tối ưu TTS local (tùy chọn) ─────────────────────
# OmniVoice: 32 bước cân bằng chất lượng/tốc độ; 0 = tự chọn lô (GPU knee khoảng 8).
OMNIVOICE_NUM_STEP=32
OMNIVOICE_BATCH_SIZE=0
